# Shared experiment config template.
# `template-train` and `template-infer` both validate this file; each uses its
# own sections. See docs/cli.md for the full field reference, and
# docs/config-pattern.md for the schema pattern and how to add a `kind`.
# Paths are relative to the working directory.

data:
  # Raw readers are picked by `kind`: csv | parquet. A new reader kind is
  # one schema in persistence/config.py (docs/config-pattern.md).
  train:
    kind: csv
    path: data/train.csv
  test:
    kind: csv
    path: data/test.csv
  id_column: id # always metadata: kept untouched, reassembled into predictions
  target:
    column: label
    mapping: # class indices; must cover exactly 0..model.n_classes-1
      negative: 0
      positive: 1
  # metadata: [] # extra columns kept untouched as sample identity (id_column
  #   is always included); metadata, target, and exclude must not overlap
  # exclude: [] # dropped columns; features are everything that remains
  encodings:
    # Categorical feature columns need declared levels (inline, or one level
    # per line in a vocab file via levels_path); unlisted feature columns
    # pass through numerically. Available kinds:
    #   one_hot {column, levels | levels_path}
    - kind: one_hot
      column: city
      levels: [a, b, c]

processing:
  # One ordered list of tensor-only steps, applied per batch after the move
  # to the training device: preprocessing and augmentation interleave freely
  # (stacking is list order). Column names resolve to feature blocks at
  # composition; a step on a non-feature column fails at build.
  # `stages` picks where a step runs: train | eval | predict.
  #   scale_by_cap / log_scale_by_cap default to all stages (predict-time
  #   scaling is part of the feature definition);
  #   gaussian_noise defaults to [train].
  # Available kinds:
  #   scale_by_cap {column, cap, floor} |
  #   log_scale_by_cap {column, cap} | gaussian_noise {std}
  steps:
    - kind: scale_by_cap
      column: age
      cap: 100
      floor: 0.0
    # - kind: log_scale_by_cap
    #   column: income
    #   cap: 1000000
    - kind: gaussian_noise
      std: 0.01
      stages: [train]
    # Seeded validation-time augmentation: runs on val batches at stage
    # "eval" with per-(seed, stage, epoch, batch) generators, so a seeded
    # run reproduces exactly.
    # - kind: gaussian_noise
    #   std: 0.005
    #   stages: [eval]

model:
  # Architectures are picked by `kind`; this template ships `mlp`. A new
  # kind is one schema in models/config.py (docs/config-pattern.md).
  kind: mlp
  hidden_size: 128
  hidden_depth: 2 # Linear -> ReLU -> LayerNorm -> Dropout blocks
  n_classes: 2 # input size is the schema's feature width (known before any row is read)
  dropout: 0.0 # p per hidden block; 0 disables

optimizer:
  kind: adamw # adam | adamw | sgd
  lr: 0.001
  weight_decay: 0.0001
  # momentum: 0.0 # sgd only

loss:
  kind: cross_entropy # model returns logits
  # class_weights: balanced # or null (default); inverse-frequency weights
  #   from the train split, only for cross_entropy

training:
  epochs: 10
  batch_size: 4096
  val_fraction: 0.1
  seed: 42 # partition, shuffle, and processing RNG streams
  shuffle: true
  device: auto # auto | cpu | cuda | mps
  # stdout: one params line + periodic metrics (every_n_steps, final epoch
  #   always); null: silent; mlflow: logs to a run the CLI opens. MLflow
  #   fields: experiment_name (default template), run_name, tracking_uri.
  trackers:
    - kind: stdout
      # every_n_steps: 10
    # - kind: mlflow
    #   experiment_name: template
    #   run_name: baseline
    #   tracking_uri: http://localhost:5000
  # track_gradients: false # log train/grad_norm (mean per-batch total L2 norm)
  checkpoint_path: outputs/model.pt

inference:
  batch_size: 8192
  save: true # write output_path as id,label (class-1 probabilities)
  report: true # print rows + probability summary
  output_path: outputs/predictions.csv
